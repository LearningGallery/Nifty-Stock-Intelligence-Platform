# ---------------------------------------------------------
# Example Terraform Variables File
# Copy to terraform.tfvars and customize
# ---------------------------------------------------------

# AWS Configuration
aws_region     = "ap-south-1"
aws_account_id = "123456789012" # Replace with your AWS account ID

# Project Configuration
project_name = "nifty-stock-intel"
environment  = "dev" # or "staging", "prod"

# Networking
vpc_cidr               = "10.0.0.0/16"
availability_zones     = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs    = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs   = ["10.0.11.0/24", "10.0.12.0/24"]

# ECS Backend Service
backend_image_tag          = "latest"
backend_cpu                = 1024  # 1 vCPU
backend_memory             = 2048  # 2 GB
backend_desired_count      = 2
backend_auto_scaling_min   = 1
backend_auto_scaling_max   = 10

# Bedrock Configuration
bedrock_model_id           = "anthropic.claude-3-5-sonnet-20240620-v1:0"
bedrock_embedding_model_id = "amazon.titan-embed-text-v2:0"
bedrock_max_tokens         = 4096
bedrock_temperature        = 0.7

# OpenSearch Configuration
opensearch_instance_type   = "t3.medium.search"
opensearch_instance_count  = 2
opensearch_ebs_volume_size = 100
opensearch_version         = "2.11"

# DynamoDB Configuration
dynamodb_billing_mode            = "PAY_PER_REQUEST"
dynamodb_point_in_time_recovery  = true

# Cognito Configuration
cognito_password_minimum_length = 12
cognito_mfa_configuration       = "OPTIONAL"

# Lambda Configuration
lambda_runtime                  = "python3.11"
lambda_memory_size              = 512
lambda_timeout                  = 300
ingestion_schedule_expression   = "rate(30 minutes)"

# CloudFront Configuration
cloudfront_price_class = "PriceClass_All"

# WAF Configuration
waf_rate_limit       = 2000
waf_blocked_countries = []

# Monitoring Configuration
cloudwatch_log_retention_days = 30
enable_xray_tracing           = true
alarm_email_endpoint          = "your-email@example.com"

# ElastiCache Configuration
redis_node_type       = "cache.t3.micro"
redis_num_cache_nodes = 1
redis_engine_version  = "7.0"

# Additional Tags
additional_tags = {
  Team       = "Engineering"
  CostCenter = "Development"
}
