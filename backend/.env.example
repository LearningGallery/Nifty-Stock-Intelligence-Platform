# Environment
ENVIRONMENT=dev
AWS_REGION=ap-south-1
LOG_LEVEL=DEBUG

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.7

# OpenSearch Configuration
OPENSEARCH_ENDPOINT=https://your-opensearch-endpoint.ap-south-1.es.amazonaws.com
OPENSEARCH_INDEX=stock-documents
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Admin@12345

# DynamoDB Configuration
CHAT_SESSIONS_TABLE=nifty-stock-intel-dev-chat-sessions
CHAT_MESSAGES_TABLE=nifty-stock-intel-dev-chat-messages
DOCUMENT_METADATA_TABLE=nifty-stock-intel-dev-document-metadata
STOCK_ANALYSIS_CACHE_TABLE=nifty-stock-intel-dev-stock-analysis-cache

# Cognito Configuration
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-client-id
COGNITO_REGION=ap-south-1

# S3 Configuration
DATA_LAKE_BUCKET=nifty-stock-intel-dev-data-lake-xxxxx

# Redis Configuration
REDIS_ENDPOINT=your-redis-endpoint.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL_SECONDS=300

# API Keys (stored in Secrets Manager)
API_KEYS_SECRET_NAME=nifty-stock-intel-dev-backend-api-keys

# Application Configuration
ENABLE_XRAY=true
ENABLE_CORS=true
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
